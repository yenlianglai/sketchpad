{
  "name": "sketchpad-mcp",
  "version": "1.1.1",
  "description": "An iPad handwriting pad your coding agent can see, answer, and draw on.",
  "keywords": [
    "mcp",
    "ipad",
    "apple-pencil",
    "drawing",
    "canvas",
    "whiteboard",
    "agent",
    "claude"
  ],
  "homepage": "https://github.com/yenlianglai/sketchpad",
  "bugs": {
    "url": "https://github.com/yenlianglai/sketchpad/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yenlianglai/sketchpad.git"
  },
  "license": "MIT",
  "author": "Ryan Lai",
  "type": "module",
  "bin": {
    "sketchpad": "scripts/cli.mjs",
    "sketchpad-mcp": "server/mcp-stdio.mjs"
  },
  "files": [
    "server/",
    "README.md",
    "LICENSE",
    "scripts/"
  ],
  "scripts": {
    "start": "node server/index.mjs",
    "register": "node scripts/register.mjs",
    "bundle": "npx -y @anthropic-ai/mcpb pack . dist/sketchpad.mcpb",
    "test": "node --test test/*.test.mjs",
    "test:ios": "cd ios && xcodegen generate && DEVELOPER_DIR=${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer} xcodebuild test -project Sketchpad.xcodeproj -scheme Sketchpad -destination 'platform=iOS Simulator,name=iPad Pro 11-inch (M5)' -derivedDataPath build CODE_SIGNING_ALLOWED=NO -quiet",
    "app": "cd ios && xcodegen generate && open Sketchpad.xcodeproj",
    "setup": "node scripts/cli.mjs install",
    "status": "node scripts/cli.mjs status",
    "pair": "node scripts/cli.mjs pair",
    "sketchpad": "node scripts/cli.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "bonjour-service": "^1.4.4",
    "selfsigned": "^2.4.1",
    "ws": "^8.18.0",
    "zod": "^4.6.2"
  },
  "private": false
}
