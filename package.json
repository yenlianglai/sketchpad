{
  "name": "sketchpad",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "description": "An iPad handwriting pad your coding agent can see, answer, and draw on.",
  "scripts": {
    "start": "node server/index.mjs",
    "register": "node scripts/register.mjs",
    "bundle": "npx -y @anthropic-ai/mcpb pack . dist/sketchpad.mcpb",
    "test": "node scripts/test-mcp.mjs && node scripts/test-stdio.mjs",
    "test:mcp": "node scripts/test-mcp.mjs",
    "test:stdio": "node scripts/test-stdio.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.0",
    "zod": "^4.6.2"
  },
  "bin": {
    "sketchpad-mcp": "./server/mcp-stdio.mjs"
  },
  "keywords": [
    "mcp",
    "ipad",
    "apple-pencil",
    "drawing",
    "canvas",
    "whiteboard",
    "agent",
    "claude"
  ],
  "author": "Ryan Lai",
  "license": "MIT",
  "homepage": "https://github.com/ryanlai/sketchpad",
  "repository": {
    "type": "git",
    "url": "https://github.com/ryanlai/sketchpad.git"
  },
  "files": [
    "server/",
    "scripts/register.mjs",
    "README.md",
    "LICENSE"
  ]
}
